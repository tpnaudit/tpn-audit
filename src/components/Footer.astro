---
import { site, t, withBase, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const prefix = lang === 'en' ? '/en' : '';
const year = new Date().getFullYear();

const links = [
  { href: withBase(`${prefix}/`), label: d.nav.home },
  { href: withBase(`${prefix}/services/`), label: d.nav.services },
  { href: withBase(`${prefix}/about/`), label: d.nav.about },
  { href: withBase(`${prefix}/contact/`), label: d.nav.contact },
];
---

<footer class="border-t border-cream-200/15 bg-pine-950 text-cream-200">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[minmax(0,1fr)_auto_auto] md:gap-x-16 md:py-14">
    <div>
      <div class="flex items-center gap-3">
        <span class="flex h-10 w-10 items-center justify-center border-2 border-cream-200/70 font-display text-[13px] font-bold tracking-wider text-cream-200">TPN</span>
        <span class="leading-tight">
          <span class="block font-display text-[16px] font-semibold">TPN Audit & Consulting</span>
          <span class="block text-[9.5px] uppercase tracking-[0.22em] text-gold-400">{site.tagline}</span>
        </span>
      </div>
      <p class="mt-5 text-sm font-semibold text-cream-100">{lang === 'th' ? site.legalNameTh : site.nameEn}</p>
      <p class="mt-1 max-w-md text-sm leading-7 text-cream-200/65">{lang === 'th' ? site.addressTh : site.addressEn}</p>
      <p class="mt-4 max-w-md text-sm leading-7 text-cream-200/65">{d.footer.desc}</p>
    </div>

    <div>
      <h3 class="text-[11px] font-semibold uppercase tracking-[0.2em] text-gold-400">{d.footer.linksHead}</h3>
      <ul class="mt-5 space-y-3">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="text-sm text-cream-200/75 transition-colors hover:text-cream-100">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="text-[11px] font-semibold uppercase tracking-[0.2em] text-gold-400">{d.footer.contactHead}</h3>
      <ul class="mt-5 space-y-3 text-sm text-cream-200/75">
        <li><a href={`tel:${site.phone}`} class="transition-colors hover:text-cream-100">{site.phoneDisplay}</a></li>
        <li>
          <a href={site.lineUrl} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-cream-100">
            {d.footer.lineNote}
          </a>
        </li>
        <li><a href={`mailto:${site.email}`} class="break-all transition-colors hover:text-cream-100">{site.email}</a></li>
        <li>{lang === 'th' ? site.addressTh : site.addressEn}</li>
      </ul>
    </div>
  </div>
  <div class="border-t border-cream-200/10 py-6 text-center text-xs tracking-wide text-cream-200/45">
    © {year} {lang === 'th' ? site.legalNameTh : site.nameEn} — {d.footer.rights}
  </div>
</footer>
