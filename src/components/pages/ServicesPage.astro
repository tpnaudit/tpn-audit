---
import Base from '../../layouts/Base.astro';
import { t, withBase, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const s = d.services;
const prefix = lang === 'en' ? '/en' : '';
---

<Base lang={lang} title={s.metaTitle} description={s.metaDesc} page="services" faqSchema>
  <section class="mx-auto max-w-6xl px-4 pb-4 pt-16 sm:px-6 md:pt-20">
    <h1 class="text-4xl font-bold tracking-tight text-pine-950 md:text-5xl">{s.head}</h1>
    <p class="mt-4 max-w-2xl text-pine-700 md:text-lg">{s.sub}</p>
    <p class="mt-6 inline-flex items-center gap-2 rounded-full border border-gold-500/40 bg-gold-300/10 px-4 py-2 text-sm font-medium text-gold-600">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="12" cy="12" r="9" /><path d="M12 8v4l2.5 2.5" />
      </svg>
      {s.priceNote}
    </p>
  </section>

  <section class="mx-auto max-w-6xl space-y-8 px-4 py-14 sm:px-6">
    {
      s.list.map((sv, i) => (
        <article id={sv.id} class="scroll-mt-24 rounded-3xl border border-pine-900/10 bg-cream-50 p-7 md:p-12">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-600">{String(i + 1).padStart(2, '0')}</p>
              <h2 class="mt-2 text-2xl font-bold tracking-tight text-pine-950 md:text-3xl">{sv.title}</h2>
            </div>
            <span class="rounded-full bg-pine-900 px-4 py-1.5 text-xs font-semibold text-cream-100">{s.priceLabel}</span>
          </div>
          <div class="mt-6 max-w-3xl space-y-4">
            {sv.body.map((p) => (
              <p class="leading-relaxed text-pine-800">{p}</p>
            ))}
          </div>
        </article>
      ))
    }
  </section>

  <!-- FAQ -->
  <section class="border-t border-pine-900/10 bg-cream-50">
    <div class="mx-auto max-w-4xl px-4 py-20 sm:px-6">
      <h2 class="text-3xl font-bold tracking-tight text-pine-950 md:text-4xl">{s.faqHead}</h2>
      <p class="mt-3 text-pine-700">{s.faqSub}</p>
      <div class="mt-10 divide-y divide-pine-900/10 rounded-2xl border border-pine-900/10 bg-cream-100">
        {
          s.faq.map((f) => (
            <details class="group px-6 py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[15px] font-semibold text-pine-950 [&::-webkit-details-marker]:hidden">
                {f.q}
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  class="shrink-0 text-gold-600 transition-transform group-open:rotate-45"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <p class="mt-3 pr-8 text-sm leading-relaxed text-pine-700">{f.a}</p>
            </details>
          ))
        }
      </div>
      <div class="mt-10 text-center">
        <a
          href={withBase(`${prefix}/contact/`)}
          class="inline-block rounded-full bg-pine-900 px-8 py-3.5 text-sm font-semibold text-cream-100 shadow-lg shadow-pine-900/15 transition-all hover:-translate-y-0.5 hover:bg-pine-800"
        >
          {d.nav.cta}
        </a>
      </div>
    </div>
  </section>
</Base>
