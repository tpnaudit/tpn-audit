---
import Base from '../../layouts/Base.astro';
import { t, withBase, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const s = d.services;
const prefix = lang === 'en' ? '/en' : '';
const L =
  lang === 'en'
    ? { fee: 'Fee', detail: 'View details', overview: 'All services' }
    : { fee: 'ค่าบริการ', detail: 'ดูรายละเอียด', overview: 'บริการทั้งหมด' };
// Split a price string into a bold headline and a parenthetical tail; flag fixed (has a number).
const parsePrice = (price: string) => {
  const fixed = /\d/.test(price);
  const i = price.indexOf('(');
  const main = i === -1 ? price : price.slice(0, i).trim();
  const paren = i === -1 ? '' : price.slice(i).trim();
  return { fixed, main, paren };
};
---

<Base lang={lang} title={s.metaTitle} description={s.metaDesc} page="services" faqSchema>
  <!-- Page header -->
  <section class="border-b border-pine-900/10">
    <div class="mx-auto max-w-6xl px-4 pb-14 pt-16 sm:px-6 md:pb-20 md:pt-24">
      <h1 class="font-display text-4xl font-semibold text-brand md:text-[3.25rem] md:leading-tight">{s.head}</h1>
      <p class="mt-5 max-w-2xl text-pine-600 md:text-lg">{s.sub}</p>
      <p class="mt-8 inline-block bg-cream-50 px-5 py-3 text-sm text-pine-700">{s.priceNote}</p>
    </div>
  </section>

  <!-- Service overview: scannable cards with prominent pricing -->
  <section class="mx-auto max-w-6xl px-4 pt-10 sm:px-6 md:pt-14">
    <p class="tpn-label flex items-center gap-3 text-brand">
      <span class="h-[2px] w-8 bg-gold-500" aria-hidden="true"></span>
      {L.overview}
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        s.list.map((sv) => {
          const p = parsePrice(sv.price);
          const note = (sv as { note?: string }).note;
          return (
            <a
              href={`#${sv.id}`}
              class="group flex flex-col border-t-2 border-gold-500 bg-cream-100 p-6 transition-colors hover:border-brand"
            >
              <h3 class="font-display text-[19px] font-semibold leading-snug text-brand">{sv.title}</h3>
              {p.fixed ? (
                <p class="mt-4 font-display text-[22px] font-semibold leading-tight text-brand">
                  {p.main}
                  {p.paren && <span class="mt-0.5 block text-xs font-normal text-pine-500">{p.paren}</span>}
                </p>
              ) : (
                <p class="tpn-label mt-4 text-gold-600">{sv.price}</p>
              )}
              {note && <p class="mt-1.5 text-xs text-pine-500">{note}</p>}
              <p class="mt-4 flex-1 text-sm leading-relaxed text-pine-600">{sv.short}</p>
              <span class="mt-6 inline-flex items-center gap-1.5 font-display text-[13px] font-medium text-brand">
                {L.detail}
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-gold-500 transition-transform group-hover:translate-x-1"
                >
                  <path d="M5 12h14m-6-6 6 6-6 6" />
                </svg>
              </span>
            </a>
          );
        })
      }
    </div>
  </section>

  <!-- Service detail sections -->
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 md:py-12">
    {
      s.list.map((sv) => {
        const p = parsePrice(sv.price);
        const note = (sv as { note?: string }).note;
        return (
          <article id={sv.id} class="scroll-mt-24 border-b border-pine-900/10 py-12 last:border-b-0 md:py-16">
            <div class="grid gap-8 md:grid-cols-[1fr_2fr]">
              <div>
                <h2 class="font-display font-semibold text-2xl text-brand md:text-[28px] md:leading-snug">{sv.title}</h2>
                <div class="mt-6 border-t-2 border-gold-500 pt-4">
                  <div class="tpn-label text-gold-600">{L.fee}</div>
                  {p.fixed ? (
                    <p class="mt-1.5 font-display text-2xl font-semibold leading-tight text-brand">
                      {p.main}
                      {p.paren && <span class="mt-1 block text-sm font-normal text-pine-500">{p.paren}</span>}
                    </p>
                  ) : (
                    <p class="mt-1.5 font-display text-lg font-medium text-pine-700">{sv.price}</p>
                  )}
                  {note && <p class="mt-2 text-xs text-pine-500">{note}</p>}
                </div>
              </div>
              <div class="space-y-5">
                {sv.body.map((para) => (
                  <p class="leading-relaxed text-pine-800">{para}</p>
                ))}
              </div>
            </div>
          </article>
        );
      })
    }
  </section>

  <!-- FAQ -->
  <section class="border-t border-pine-200">
    <div class="mx-auto max-w-4xl px-4 py-20 sm:px-6 md:py-24">
      <h2 class="font-display text-3xl font-semibold text-brand md:text-4xl">{s.faqHead}</h2>
      <p class="mt-3 text-pine-700">{s.faqSub}</p>
      <div class="mt-10 border-t-2 border-gold-500">
        {
          s.faq.map((f) => (
            <details class="group border-b border-pine-200 px-1 py-4 open:bg-cream-50 open:px-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[15px] font-semibold text-pine-950 [&::-webkit-details-marker]:hidden">
                {f.q}
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  class="shrink-0 text-gold-600 transition-transform group-open:rotate-45"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <p class="mt-3 max-w-3xl pr-8 text-sm leading-relaxed text-pine-700">{f.a}</p>
            </details>
          ))
        }
      </div>
      <div class="mt-12">
        <a
          href={withBase(`${prefix}/contact/`)}
          class="inline-block bg-pine-900 px-8 py-3.5 text-sm font-semibold tracking-wide text-cream-100 transition-colors hover:bg-brand-dark"
        >
          {d.nav.cta}
        </a>
      </div>
    </div>
  </section>
</Base>
