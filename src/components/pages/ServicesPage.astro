---
import Base from '../../layouts/Base.astro';
import { t, withBase, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const s = d.services;
const prefix = lang === 'en' ? '/en' : '';
---

<Base lang={lang} title={s.metaTitle} description={s.metaDesc} page="services" faqSchema>
  <!-- Page header -->
  <section class="bg-pine-950 text-cream-100">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
      <span class="block h-px w-10 bg-gold-500" aria-hidden="true"></span>
      <h1 class="mt-6 font-display text-4xl font-semibold text-cream-50 md:text-5xl">{s.head}</h1>
      <p class="mt-5 max-w-2xl text-cream-200/75 md:text-lg">{s.sub}</p>
      <p class="mt-7 inline-block border border-gold-500/50 px-5 py-3 text-sm text-gold-300">{s.priceNote}</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-6 sm:px-6 md:py-10">
    {
      s.list.map((sv, i) => (
        <article id={sv.id} class="scroll-mt-24 border-b border-pine-900/15 py-12 last:border-b-0 md:py-16">
          <div class="grid gap-8 md:grid-cols-[1fr_2fr]">
            <div>
              <span class="block h-px w-10 bg-gold-500" aria-hidden="true"></span>
              <h2 class="mt-4 font-display text-2xl font-semibold text-pine-950 md:text-[28px] md:leading-snug">{sv.title}</h2>
              <span class="mt-5 inline-block rounded-md border border-pine-900/25 px-3.5 py-1.5 text-xs font-semibold tracking-wide text-pine-800">
                {sv.price}
              </span>
            </div>
            <div class="space-y-5">
              {sv.body.map((p) => (
                <p class="leading-relaxed text-pine-800">{p}</p>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <!-- FAQ -->
  <section class="border-t border-pine-900/10 bg-cream-50">
    <div class="mx-auto max-w-4xl px-4 py-20 sm:px-6 md:py-24">
      <span class="block h-px w-10 bg-gold-500" aria-hidden="true"></span>
      <h2 class="mt-5 font-display text-3xl font-semibold text-pine-950 md:text-4xl">{s.faqHead}</h2>
      <p class="mt-3 text-pine-700">{s.faqSub}</p>
      <div class="mt-12 border-t border-pine-900/15">
        {
          s.faq.map((f) => (
            <details class="group border-b border-pine-900/15 py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[15px] font-semibold text-pine-950 [&::-webkit-details-marker]:hidden">
                {f.q}
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  class="shrink-0 text-gold-600 transition-transform group-open:rotate-45"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <p class="mt-4 max-w-3xl pr-8 text-sm leading-relaxed text-pine-700">{f.a}</p>
            </details>
          ))
        }
      </div>
      <div class="mt-12">
        <a
          href={withBase(`${prefix}/contact/`)}
          class="inline-block rounded-md bg-pine-900 px-8 py-3.5 text-sm font-semibold tracking-wide text-cream-100 transition-colors hover:bg-pine-800"
        >
          {d.nav.cta}
        </a>
      </div>
    </div>
  </section>
</Base>
