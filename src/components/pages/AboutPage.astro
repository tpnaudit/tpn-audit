---
import Base from '../../layouts/Base.astro';
import { site, t, withBase, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const a = d.about;
const prefix = lang === 'en' ? '/en' : '';
---

<Base lang={lang} title={a.metaTitle} description={a.metaDesc} page="about">
  <!-- Page header -->
  <section class="border-b border-pine-900/10">
    <div class="mx-auto max-w-6xl px-4 pb-14 pt-16 sm:px-6 md:pb-20 md:pt-24">
      <h1 class="font-display text-4xl font-normal text-pine-950 md:text-[3.25rem] md:leading-tight">{a.head}</h1>
      <p class="mt-5 text-lg text-pine-600">{a.sub}</p>
    </div>
  </section>

  <!-- Story -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
    <div class="grid gap-10 md:grid-cols-[1fr_2fr]">
      <div>
        <h2 class="font-display text-2xl font-medium text-pine-950 md:text-3xl">{a.storyHead}</h2>
      </div>
      <div class="max-w-[68ch]">
        <div class="space-y-6">
          {a.story.map((p) => <p class="leading-relaxed text-pine-800">{p}</p>)}
        </div>
        <div class="mt-10 border-t border-pine-900/10 pt-6 text-sm">
          <h3 class="font-display font-medium text-pine-950">{a.regHead}</h3>
          <dl class="mt-4 grid gap-x-8 gap-y-3 sm:grid-cols-[auto_minmax(0,1fr)]">
            <dt class="text-pine-600">{a.regNameLabel}</dt>
            <dd class="font-medium text-pine-900">{lang === 'th' ? site.legalNameTh : site.nameEn}</dd>
            <dt class="text-pine-600">{a.regAddressLabel}</dt>
            <dd class="leading-relaxed text-pine-900">{lang === 'th' ? site.addressTh : site.addressEn}</dd>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- TPN meaning -->
  <section class="border-y border-pine-900/10 bg-cream-50">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-24">
      <h2 class="font-display text-3xl font-medium text-pine-950 md:text-4xl">{a.meaningHead}</h2>
      <div class="mt-14 grid gap-x-14 gap-y-12 md:grid-cols-3">
        {
          a.meaning.map((m) => (
            <div class="rounded-2xl border border-pine-900/10 bg-cream-100 p-7">
              <div class="flex items-baseline gap-3">
                <span class="font-display text-5xl text-gold-500">{m.letter}</span>
                <span class="font-display text-lg font-medium tracking-wide text-pine-950">{m.word}</span>
              </div>
              <p class="mt-5 text-sm leading-relaxed text-pine-700">{m.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-24">
    <h2 class="font-display text-3xl font-medium text-pine-950 md:text-4xl">{a.valuesHead}</h2>
    <div class="mt-12 border-t border-pine-900/10">
      {
        a.values.map((v) => (
          <div class="grid gap-3 border-b border-pine-900/10 py-7 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-14 md:py-9">
            <h3 class="font-display text-lg font-medium leading-snug text-pine-950 md:text-xl">{v.title}</h3>
            <p class="max-w-[62ch] text-[15px] leading-relaxed text-pine-700">{v.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA band -->
  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 md:pb-24">
    <div class="flex flex-col items-center rounded-3xl bg-pine-950 px-6 py-14 text-center md:py-16">
      <h2 class="font-display text-2xl text-cream-100 md:text-[2.25rem]">{d.home.ctaHead}</h2>
      <a
        href={withBase(`${prefix}/contact/`)}
        class="mt-7 rounded-lg bg-gold-500 px-7 py-3.5 text-sm font-semibold text-pine-950 transition-colors hover:bg-gold-400"
      >
        {d.nav.cta}
      </a>
    </div>
  </section>
</Base>
