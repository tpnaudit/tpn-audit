---
import Base from '../../layouts/Base.astro';
import { t, withBase, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const a = d.about;
const prefix = lang === 'en' ? '/en' : '';
---

<Base lang={lang} title={a.metaTitle} description={a.metaDesc} page="about">
  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6 md:pt-20">
    <h1 class="text-4xl font-bold tracking-tight text-pine-950 md:text-5xl">{a.head}</h1>
    <p class="mt-4 text-lg text-gold-600">{a.sub}</p>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-12 md:grid-cols-[1fr_1.6fr]">
      <h2 class="text-2xl font-bold tracking-tight text-pine-950 md:text-3xl">{a.storyHead}</h2>
      <div class="space-y-5">
        {a.story.map((p) => <p class="leading-relaxed text-pine-800">{p}</p>)}
      </div>
    </div>
  </section>

  <!-- TPN meaning -->
  <section class="bg-pine-950 text-cream-100">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <h2 class="text-3xl font-bold tracking-tight md:text-4xl">{a.meaningHead}</h2>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          a.meaning.map((m) => (
            <div class="rounded-2xl border border-cream-200/10 bg-cream-200/5 p-8">
              <div class="flex items-baseline gap-3">
                <span class="text-5xl font-bold text-gold-400">{m.letter}</span>
                <span class="text-lg font-semibold tracking-wide">{m.word}</span>
              </div>
              <p class="mt-4 text-sm leading-relaxed text-cream-200/70">{m.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <h2 class="text-3xl font-bold tracking-tight text-pine-950 md:text-4xl">{a.valuesHead}</h2>
    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      {
        a.values.map((v) => (
          <div class="rounded-2xl border border-pine-900/10 bg-cream-50 p-7">
            <h3 class="flex items-center gap-3 text-lg font-semibold text-pine-950">
              <span class="h-2 w-2 rounded-full bg-gold-500" />
              {v.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-pine-700">{v.desc}</p>
          </div>
        ))
      }
    </div>
    <div class="mt-14 text-center">
      <a
        href={withBase(`${prefix}/contact/`)}
        class="inline-block rounded-full bg-pine-900 px-8 py-3.5 text-sm font-semibold text-cream-100 shadow-lg shadow-pine-900/15 transition-all hover:-translate-y-0.5 hover:bg-pine-800"
      >
        {d.nav.cta}
      </a>
    </div>
  </section>
</Base>
