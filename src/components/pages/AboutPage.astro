---
import Base from '../../layouts/Base.astro';
import { t, withBase, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const a = d.about;
const prefix = lang === 'en' ? '/en' : '';
---

<Base lang={lang} title={a.metaTitle} description={a.metaDesc} page="about">
  <!-- Page header -->
  <section class="bg-pine-950 text-cream-100">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
      <span class="block h-px w-10 bg-gold-500" aria-hidden="true"></span>
      <h1 class="mt-6 font-display text-4xl font-semibold text-cream-50 md:text-5xl">{a.head}</h1>
      <p class="mt-5 text-lg text-gold-300">{a.sub}</p>
    </div>
  </section>

  <!-- Story -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-24">
    <div class="grid gap-10 md:grid-cols-[1fr_2fr]">
      <div>
        <span class="block h-px w-10 bg-gold-500" aria-hidden="true"></span>
        <h2 class="mt-5 font-display text-2xl font-semibold text-pine-950 md:text-3xl">{a.storyHead}</h2>
      </div>
      <div class="max-w-[68ch] space-y-6">
        {a.story.map((p) => <p class="leading-relaxed text-pine-800">{p}</p>)}
      </div>
    </div>
  </section>

  <!-- TPN meaning -->
  <section class="border-y border-pine-900/10 bg-cream-50">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-24">
      <span class="block h-px w-10 bg-gold-500" aria-hidden="true"></span>
      <h2 class="mt-5 font-display text-3xl font-semibold text-pine-950 md:text-4xl">{a.meaningHead}</h2>
      <div class="mt-14 grid gap-x-14 gap-y-12 md:grid-cols-3">
        {
          a.meaning.map((m) => (
            <div class="border-t-2 border-pine-900/20 pt-6">
              <div class="flex items-baseline gap-3">
                <span class="font-display text-5xl font-semibold text-gold-600">{m.letter}</span>
                <span class="font-display text-lg font-semibold tracking-wide text-pine-950">{m.word}</span>
              </div>
              <p class="mt-5 text-sm leading-relaxed text-pine-700">{m.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-24">
    <span class="block h-px w-10 bg-gold-500" aria-hidden="true"></span>
    <h2 class="mt-5 font-display text-3xl font-semibold text-pine-950 md:text-4xl">{a.valuesHead}</h2>
    <div class="mt-12 border-t border-pine-900/10">
      {
        a.values.map((v) => (
          <div class="grid gap-3 border-b border-pine-900/10 py-7 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:gap-14 md:py-9">
            <h3 class="font-display text-lg font-semibold leading-snug text-pine-950 md:text-xl">{v.title}</h3>
            <p class="max-w-[62ch] text-[15px] leading-relaxed text-pine-700">{v.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA band -->
  <section class="bg-pine-950 text-cream-100">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-8 px-4 py-12 sm:px-6 md:flex-row md:items-center md:justify-between md:py-14">
      <h2 class="font-display text-2xl font-semibold text-cream-50 md:text-3xl">{d.home.ctaHead}</h2>
      <a
        href={withBase(`${prefix}/contact/`)}
        class="shrink-0 bg-gold-500 px-8 py-4 text-sm font-semibold tracking-wide text-pine-950 transition-colors hover:bg-gold-400"
      >
        {d.nav.cta}
      </a>
    </div>
  </section>
</Base>
