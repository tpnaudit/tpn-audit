---
import Base from '../../layouts/Base.astro';
import { site, t, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const c = d.contact;
---

<Base lang={lang} title={c.metaTitle} description={c.metaDesc} page="contact">
  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6 md:pt-20">
    <h1 class="text-4xl font-bold tracking-tight text-pine-950 md:text-5xl">{c.head}</h1>
    <p class="mt-4 max-w-2xl text-pine-700 md:text-lg">{c.sub}</p>
  </section>

  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 lg:grid-cols-[1.3fr_1fr]">
    <!-- Form -->
    <div class="rounded-3xl border border-pine-900/10 bg-cream-50 p-7 md:p-10">
      <h2 class="text-xl font-bold text-pine-950">{c.formHead}</h2>
      <form id="contact-form" class="mt-6 grid gap-5 sm:grid-cols-2">
        <label class="block text-sm font-medium text-pine-800">
          {c.name}
          <input type="text" name="name" required class="mt-1.5 w-full rounded-xl border border-pine-900/15 bg-cream-100 px-4 py-2.5 text-sm text-pine-950 outline-none transition-colors focus:border-pine-700" />
        </label>
        <label class="block text-sm font-medium text-pine-800">
          {c.company}
          <input type="text" name="company" class="mt-1.5 w-full rounded-xl border border-pine-900/15 bg-cream-100 px-4 py-2.5 text-sm text-pine-950 outline-none transition-colors focus:border-pine-700" />
        </label>
        <label class="block text-sm font-medium text-pine-800">
          {c.phone}
          <input type="tel" name="phone" required class="mt-1.5 w-full rounded-xl border border-pine-900/15 bg-cream-100 px-4 py-2.5 text-sm text-pine-950 outline-none transition-colors focus:border-pine-700" />
        </label>
        <label class="block text-sm font-medium text-pine-800">
          {c.email}
          <input type="email" name="email" class="mt-1.5 w-full rounded-xl border border-pine-900/15 bg-cream-100 px-4 py-2.5 text-sm text-pine-950 outline-none transition-colors focus:border-pine-700" />
        </label>
        <label class="block text-sm font-medium text-pine-800 sm:col-span-2">
          {c.message}
          <textarea name="message" rows="5" required class="mt-1.5 w-full rounded-xl border border-pine-900/15 bg-cream-100 px-4 py-2.5 text-sm text-pine-950 outline-none transition-colors focus:border-pine-700"></textarea>
        </label>
        <div class="sm:col-span-2">
          <button type="submit" class="w-full rounded-full bg-pine-900 px-8 py-3.5 text-sm font-semibold text-cream-100 shadow-lg shadow-pine-900/15 transition-all hover:-translate-y-0.5 hover:bg-pine-800 sm:w-auto">
            {c.submit}
          </button>
          <p class="mt-3 text-xs leading-relaxed text-pine-600">{c.formNote}</p>
        </div>
      </form>
    </div>

    <!-- Contact channels -->
    <div class="space-y-4">
      <a
        href={site.lineUrl}
        target="_blank"
        rel="noopener"
        class="flex items-center gap-4 rounded-2xl bg-[#06C755] p-6 text-white shadow-lg shadow-[#06C755]/20 transition-all hover:-translate-y-0.5"
      >
        <svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.477 2 2 5.66 2 10.18c0 4.05 3.575 7.44 8.405 8.08.327.07.773.217.886.498.101.256.066.657.032.916l-.143.86c-.044.256-.203 1.001.878.546 1.08-.455 5.83-3.435 7.954-5.88C21.58 13.53 22 11.93 22 10.18 22 5.66 17.523 2 12 2z" />
        </svg>
        <span>
          <span class="block text-lg font-bold">{c.lineLabel}</span>
          <span class="block text-sm text-white/85">ID: {site.lineId} — {c.lineSub}</span>
        </span>
      </a>

      <a href={`tel:${site.phone}`} class="flex items-center gap-4 rounded-2xl border border-pine-900/10 bg-cream-50 p-6 transition-all hover:-translate-y-0.5 hover:border-pine-900/25">
        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-pine-900/5 text-pine-800">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z" />
          </svg>
        </span>
        <span>
          <span class="block text-sm font-medium text-pine-600">{c.callLabel}</span>
          <span class="block text-lg font-bold text-pine-950">{site.phoneDisplay}</span>
        </span>
      </a>

      <a href={`mailto:${site.email}`} class="flex items-center gap-4 rounded-2xl border border-pine-900/10 bg-cream-50 p-6 transition-all hover:-translate-y-0.5 hover:border-pine-900/25">
        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-pine-900/5 text-pine-800">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 6L2 7" />
          </svg>
        </span>
        <span class="min-w-0">
          <span class="block text-sm font-medium text-pine-600">{c.emailLabel}</span>
          <span class="block break-all text-[15px] font-semibold text-pine-950">{site.email}</span>
        </span>
      </a>

      <div class="rounded-2xl border border-pine-900/10 bg-cream-50 p-6">
        <div class="flex items-start gap-4">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-pine-900/5 text-pine-800">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1116 0z" /><circle cx="12" cy="10" r="3" />
            </svg>
          </span>
          <div>
            <span class="block text-sm font-medium text-pine-600">{c.addressLabel}</span>
            <span class="block text-[15px] font-semibold text-pine-950">{lang === 'th' ? site.addressTh : site.addressEn}</span>
            <span class="mt-2 block text-sm text-pine-600">{c.hoursLabel}: {lang === 'th' ? site.hoursTh : site.hoursEn}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Map -->
  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <h2 class="sr-only">{c.mapHead}</h2>
    <div class="overflow-hidden rounded-3xl border border-pine-900/10">
      <iframe
        src={site.mapEmbed}
        width="100%"
        height="380"
        style="border:0"
        loading="lazy"
        allowfullscreen
        referrerpolicy="no-referrer-when-downgrade"
        title={c.mapHead}
      ></iframe>
    </div>
  </section>
</Base>

<script define:vars={{ email: site.email }}>
  document.getElementById('contact-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = new FormData(e.target);
    const subject = `[เว็บไซต์] ติดต่อจาก ${f.get('name')}${f.get('company') ? ' — ' + f.get('company') : ''}`;
    const body = [
      `ชื่อ: ${f.get('name')}`,
      `บริษัท: ${f.get('company') || '-'}`,
      `เบอร์โทร: ${f.get('phone')}`,
      `อีเมล: ${f.get('email') || '-'}`,
      '',
      `${f.get('message')}`,
    ].join('\n');
    window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
