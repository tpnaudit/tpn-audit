---
import Base from '../../layouts/Base.astro';
import { site, t, withBase, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const c = d.contact;

const inputClass =
  'mt-2 w-full border border-pine-900/25 bg-cream-100 px-4 py-3 text-sm text-pine-950 outline-none transition-colors focus:border-pine-900';
---

<Base lang={lang} title={c.metaTitle} description={c.metaDesc} page="contact">
  <!-- Page header -->
  <section class="bg-pine-950 text-cream-100">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
      <span class="block h-px w-10 bg-gold-500" aria-hidden="true"></span>
      <h1 class="mt-6 font-display text-4xl font-semibold text-cream-50 md:text-5xl">{c.head}</h1>
      <p class="mt-5 max-w-2xl text-cream-200/75 md:text-lg">{c.sub}</p>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[1.3fr_1fr]">
    <!-- Form -->
    <div>
      <h2 class="font-display text-2xl font-semibold text-pine-950">{c.formHead}</h2>
      <form id="contact-form" class="mt-8 grid gap-6 sm:grid-cols-2">
        <input type="hidden" name="_subject" value="[เว็บไซต์ TPN] ข้อความใหม่จากฟอร์มติดต่อ" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
        <label class="block text-sm font-medium text-pine-800">
          {c.name}
          <input type="text" name="name" required class={inputClass} />
        </label>
        <label class="block text-sm font-medium text-pine-800">
          {c.company}
          <input type="text" name="company" class={inputClass} />
        </label>
        <label class="block text-sm font-medium text-pine-800">
          {c.phone}
          <input type="tel" name="phone" required class={inputClass} />
        </label>
        <label class="block text-sm font-medium text-pine-800">
          {c.email}
          <input type="email" name="email" class={inputClass} />
        </label>
        <label class="block text-sm font-medium text-pine-800 sm:col-span-2">
          {c.message}
          <textarea name="message" rows="6" required class={inputClass}></textarea>
        </label>
        <div class="sm:col-span-2">
          <button
            type="submit"
            class="w-full rounded-md bg-pine-900 px-8 py-4 text-sm font-semibold tracking-wide text-cream-100 transition-colors hover:bg-pine-800 sm:w-auto"
          >
            {c.submit}
          </button>
          <p id="form-status" role="status" aria-live="polite" class="mt-4 hidden text-sm font-medium leading-relaxed"></p>
          <p class="mt-4 text-xs leading-relaxed text-pine-600">{c.formNote}</p>
        </div>
      </form>
    </div>

    <!-- Contact channels -->
    <div class="space-y-5">
      <!-- LINE: direct add-friend link, with QR for desktop visitors -->
      <div class="border border-[#06C755]/45 bg-pine-950 p-6">
        <a
          href={site.lineUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-4 transition-opacity hover:opacity-90"
        >
          <svg width="34" height="34" viewBox="0 0 24 24" fill="#06C755" aria-hidden="true" class="shrink-0">
            <path d="M12 2C6.477 2 2 5.66 2 10.18c0 4.05 3.575 7.44 8.405 8.08.327.07.773.217.886.498.101.256.066.657.032.916l-.143.86c-.044.256-.203 1.001.878.546 1.08-.455 5.83-3.435 7.954-5.88C21.58 13.53 22 11.93 22 10.18 22 5.66 17.523 2 12 2z" />
          </svg>
          <span>
            <span class="block font-display text-lg font-semibold text-cream-50">{c.lineLabel}</span>
            <span class="mt-1 block text-[13px] leading-relaxed text-cream-200/70">{c.lineSub}</span>
            <span class="mt-2 inline-block text-xs font-semibold tracking-wide text-[#06C755] group-hover:underline">{c.lineCta}</span>
          </span>
        </a>
        <div class="mt-5 flex items-center gap-4 border-t border-cream-200/10 pt-5">
          <img
            src={withBase('/line-qr.svg')}
            alt={c.lineQr}
            width="280"
            height="280"
            class="h-24 w-24 shrink-0 bg-white p-1"
          />
          <p class="text-xs leading-relaxed text-cream-200/60">{c.lineQr}</p>
        </div>
      </div>

      <a href={`tel:${site.phone}`} class="flex items-center gap-4 border border-pine-900/20 bg-cream-50 p-6 transition-colors hover:border-pine-900/50">
        <span class="flex h-11 w-11 shrink-0 items-center justify-center border border-pine-900/15 text-pine-800">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z" />
          </svg>
        </span>
        <span>
          <span class="block text-xs font-medium uppercase tracking-[0.15em] text-pine-600">{c.callLabel}</span>
          <span class="mt-1 block font-display text-lg font-semibold text-pine-950">{site.phoneDisplay}</span>
        </span>
      </a>

      <a href={`mailto:${site.email}`} class="flex items-center gap-4 border border-pine-900/20 bg-cream-50 p-6 transition-colors hover:border-pine-900/50">
        <span class="flex h-11 w-11 shrink-0 items-center justify-center border border-pine-900/15 text-pine-800">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 6L2 7" />
          </svg>
        </span>
        <span class="min-w-0">
          <span class="block text-xs font-medium uppercase tracking-[0.15em] text-pine-600">{c.emailLabel}</span>
          <span class="mt-1 block break-all text-[15px] font-semibold text-pine-950">{site.email}</span>
        </span>
      </a>

      <div class="border border-pine-900/20 bg-cream-50 p-6">
        <div class="flex items-start gap-4">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center border border-pine-900/15 text-pine-800">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1116 0z" /><circle cx="12" cy="10" r="3" />
            </svg>
          </span>
          <div>
            <span class="block text-xs font-medium uppercase tracking-[0.15em] text-pine-600">{c.addressLabel}</span>
            <span class="mt-1 block text-[15px] font-semibold text-pine-950">{lang === 'th' ? site.legalNameTh : site.nameEn}</span>
            <span class="mt-1 block text-sm leading-relaxed text-pine-700">{lang === 'th' ? site.addressTh : site.addressEn}</span>
            <span class="mt-2 block text-sm text-pine-600">{c.hoursLabel}: {lang === 'th' ? site.hoursTh : site.hoursEn}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Map -->
  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <h2 class="sr-only">{c.mapHead}</h2>
    <div class="overflow-hidden border border-pine-900/20">
      <iframe
        src={site.mapEmbed}
        width="100%"
        height="380"
        style="border:0"
        loading="lazy"
        allowfullscreen
        referrerpolicy="no-referrer-when-downgrade"
        title={c.mapHead}
      ></iframe>
    </div>
    <a
      href={site.mapLink}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-pine-900 transition-colors hover:text-gold-600"
    >
      {c.mapCta}
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 17 17 7M9 7h8v8" />
      </svg>
    </a>
  </section>
</Base>

<script define:vars={{ email: site.email, sending: c.formSending, success: c.formSuccess, failed: c.formError }}>
  const form = document.getElementById('contact-form');
  const status = document.getElementById('form-status');
  const button = form?.querySelector('button[type="submit"]');
  const buttonLabel = button?.textContent ?? '';

  const show = (message, ok) => {
    if (!status) return;
    status.textContent = message;
    status.classList.remove('hidden');
    status.classList.toggle('text-pine-900', ok !== false);
    status.classList.toggle('text-red-700', ok === false);
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    // FormSubmit uses this to set the reply-to address on the email it forwards
    if (data.get('email')) data.append('_replyto', data.get('email'));

    show(sending, true);
    if (button) {
      button.disabled = true;
      button.textContent = sending;
    }

    try {
      const response = await fetch(`https://formsubmit.co/ajax/${email}`, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: data,
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || String(result.success) !== 'true') throw new Error('send failed');
      show(success, true);
      form.reset();
    } catch {
      show(failed, false);
    } finally {
      if (button) {
        button.disabled = false;
        button.textContent = buttonLabel;
      }
    }
  });
</script>
