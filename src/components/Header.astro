---
import { t, withBase, switchLangPath, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  page: '' | 'services' | 'about' | 'contact';
}
const { lang, page } = Astro.props;
const d = t(lang);
const prefix = lang === 'en' ? '/en' : '';

const links = [
  { href: withBase(`${prefix}/`), label: d.nav.home, key: '' },
  { href: withBase(`${prefix}/services/`), label: d.nav.services, key: 'services' },
  { href: withBase(`${prefix}/about/`), label: d.nav.about, key: 'about' },
  { href: withBase(`${prefix}/contact/`), label: d.nav.contact, key: 'contact' },
];
---

<header class="sticky top-0 z-50 border-b border-pine-900/10 bg-cream-100/85 backdrop-blur-md">
  <div class="mx-auto flex h-[68px] max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href={withBase(`${prefix}/`)} class="flex items-center gap-3" aria-label="TPN Audit & Consulting">
      <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-gold-500 font-display text-[12px] font-semibold tracking-wide text-pine-950">TPN</span>
      <span class="leading-tight">
        <span class="block font-display text-[17px] font-medium text-pine-950">TPN Audit</span>
        <span class="block text-[9.5px] uppercase tracking-[0.22em] text-pine-600">& Consulting</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              'rounded-lg px-3 py-1.5 text-[14px] font-medium transition-colors hover:bg-cream-50 hover:text-pine-950',
              l.key === page
                ? 'bg-cream-50 text-pine-950'
                : 'text-pine-700',
            ]}
            aria-current={l.key === page ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={switchLangPath(lang, page)}
        class="px-2 py-1 text-xs font-semibold tracking-[0.12em] text-pine-700 underline-offset-4 transition-colors hover:text-pine-950 hover:underline"
      >
        {d.switchLabel}
      </a>
      <a
        href={withBase(`${prefix}/contact/`)}
        class="hidden rounded-lg bg-pine-950 px-4 py-2 text-[13px] font-semibold text-cream-100 transition-colors hover:bg-pine-800 sm:inline-block"
      >
        {d.nav.cta}
      </a>
      <button
        id="menu-btn"
        class="inline-flex h-9 w-9 items-center justify-center text-pine-900 md:hidden"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-pine-900/15 bg-cream-100 px-4 py-3 md:hidden" aria-label="Mobile">
    {
      links.map((l) => (
        <a
          href={l.href}
          class:list={[
            'block border-l-2 px-4 py-3 text-sm font-medium',
            l.key === page ? 'border-gold-500 bg-cream-50 text-pine-950' : 'border-transparent text-pine-700',
          ]}
        >
          {l.label}
        </a>
      ))
    }
    <a href={withBase(`${prefix}/contact/`)} class="mt-3 block rounded-lg bg-pine-900 px-4 py-3 text-center text-sm font-semibold text-cream-100">
      {d.nav.cta}
    </a>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
