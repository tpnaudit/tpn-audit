---
import { t, withBase, switchLangPath, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  page: '' | 'services' | 'about' | 'contact';
}
const { lang, page } = Astro.props;
const d = t(lang);
const prefix = lang === 'en' ? '/en' : '';

const links = [
  { href: withBase(`${prefix}/`), label: d.nav.home, key: '' },
  { href: withBase(`${prefix}/services/`), label: d.nav.services, key: 'services' },
  { href: withBase(`${prefix}/about/`), label: d.nav.about, key: 'about' },
  { href: withBase(`${prefix}/contact/`), label: d.nav.contact, key: 'contact' },
];
---

<header class="sticky top-0 z-50 border-b border-pine-900/10 bg-cream-100/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href={withBase(`${prefix}/`)} class="flex items-center gap-2.5" aria-label="TPN Audit & Consulting">
      <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-pine-900 font-bold tracking-wide text-cream-200 text-sm">TPN</span>
      <span class="leading-tight">
        <span class="block text-[15px] font-semibold tracking-wide text-pine-950">TPN Audit</span>
        <span class="block text-[10px] uppercase tracking-[0.18em] text-pine-600">& Consulting</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Main">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              'text-sm font-medium transition-colors hover:text-pine-900',
              l.key === page ? 'text-pine-900 underline decoration-gold-500 decoration-2 underline-offset-8' : 'text-pine-700',
            ]}
            aria-current={l.key === page ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={switchLangPath(lang, page)}
        class="rounded-full border border-pine-900/20 px-3 py-1.5 text-xs font-semibold tracking-wide text-pine-800 transition-colors hover:border-pine-900 hover:bg-pine-900 hover:text-cream-100"
      >
        {d.switchLabel}
      </a>
      <a
        href={withBase(`${prefix}/contact/`)}
        class="hidden rounded-full bg-pine-900 px-4 py-2 text-sm font-semibold text-cream-100 shadow-sm transition-colors hover:bg-pine-800 sm:inline-block"
      >
        {d.nav.cta}
      </a>
      <button
        id="menu-btn"
        class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-pine-900 md:hidden"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-pine-900/10 bg-cream-100 px-4 py-3 md:hidden" aria-label="Mobile">
    {
      links.map((l) => (
        <a
          href={l.href}
          class:list={[
            'block rounded-lg px-3 py-2.5 text-sm font-medium',
            l.key === page ? 'bg-pine-900/5 text-pine-900' : 'text-pine-700',
          ]}
        >
          {l.label}
        </a>
      ))
    }
    <a href={withBase(`${prefix}/contact/`)} class="mt-2 block rounded-lg bg-pine-900 px-3 py-2.5 text-center text-sm font-semibold text-cream-100">
      {d.nav.cta}
    </a>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
